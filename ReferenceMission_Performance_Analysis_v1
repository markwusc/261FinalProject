%% =========================================================================
%  SECTION 7 — FINAL CLIMB SIMULATION (vector storage for plotting)
%
%  Identical physics to the scalar climb in Section 5, but now every time
%  step is stored for Figure 1. Uses the converged W2_kg.
% =========================================================================

W2_N_final = W2_kg * g;   % converged weight at base of climb [N]

max_pts = 7000;  % preallocate conservatively (h_cruise/ROC_min ≈ 4572/5 ≈ 914 steps)
t_clmb_vec  = zeros(1, max_pts);
h_clmb_vec  = zeros(1, max_pts);
dx_clmb_vec = zeros(1, max_pts);
V_clmb_vec  = V_climb * ones(1, max_pts);  % TAS constant throughout climb

h_c   = 0.0;
d_c   = 0.0;
t_c   = 0.0;
step  = 1;
t_clmb_vec(1)  = 0;
h_clmb_vec(1)  = 0;
dx_clmb_vec(1) = 0;

while h_c < h_cruise
    [~, rho_c, ~, ~] = StdAtmos(h_c);
    sigma_c = rho_c / rho_SL;
    P_A_c   = sigma_c * P_A_SL;
    T_c     = P_A_c / V_climb;
    q_c     = 0.5 * rho_c * V_climb^2;
    CL_c    = W2_N_final / (q_c * S);
    CD_c    = CD0 + k * CL_c^2;
    D_c     = q_c * S * CD_c;
    ROC_c   = V_climb * (T_c - D_c) / W2_N_final;

    if ROC_c <= 0, break; end

    gamma_c   = asin(min(ROC_c / V_climb, 1.0));
    V_horiz_c = V_climb * cos(gamma_c);
    dt_eff    = min(dt_climb, (h_cruise - h_c) / ROC_c);

    d_c   = d_c + V_horiz_c * dt_eff;
    t_c   = t_c + dt_eff;
    h_c   = h_c + ROC_c * dt_eff;

    step = step + 1;
    if step > max_pts
        warning('PUDO670:Preallocate', ...
            'Preallocated climb array exceeded. Increase max_pts in Section 7.');
        break;
    end
    t_clmb_vec(step)  = t_c;
    h_clmb_vec(step)  = h_c;
    dx_clmb_vec(step) = d_c;
end

n_clmb      = step;
t_clmb_min  = t_clmb_vec(1:n_clmb) / 60;   % [min]
h_clmb      = h_clmb_vec(1:n_clmb);         % [m]
dx_clmb     = dx_clmb_vec(1:n_clmb);        % [m] cumulative horiz distance
V_clmb      = V_clmb_vec(1:n_clmb);         % [m/s]


%% =========================================================================
%  SECTION 8 — THROTTLE PROFILES
%
%  8a. CLIMB   : 100% full throttle throughout (team decision, fixed speed)
%  8b. CRUISE  : T = D (level flight); throttle decreases as weight drops
%  8c. DESCENT : Along-path balance T = D − W·sin(γ_desc)
%                If T ≤ 0 → throttle = 0 (gravity exceeds drag requirement)
%                If T > 0 → throttle = T·V / P_A(h)
%
%  All throttle values are % of maximum available power at that altitude.
%  Fuel consumption uses Raymer/Breguet fractions — NOT these throttle values.
%  Throttle charts are informational and for report illustration.
% =========================================================================

% --- 8a: Climb throttle (constant 100%) ----------------------------------
thr_clmb_pct = 100 * ones(1, n_clmb);   % [%]

% --- 8b: Cruise throttle (decreasing as weight falls) --------------------
n_cr = 300;
t_cr_rel = linspace(0, t_cruise_min, n_cr);           % time relative to cruise start [min]
W_cr_N   = linspace(W3_kg, W4_kg, n_cr) * g;          % weight from W3 to W4 [N]

[~, rho_cr, ~, ~] = StdAtmos(h_cruise);
sigma_cr   = rho_cr / rho_SL;
P_A_cr     = sigma_cr * P_A_SL;                        % [W] prop power at cruise alt
q_cr       = 0.5 * rho_cr * V_cruise^2;               % [N/m²]
CL_cr_vec  = W_cr_N / (q_cr * S);                     % [-]
CD_cr_vec  = CD0 + k * CL_cr_vec.^2;                  % [-]
T_cr_vec   = q_cr * S * CD_cr_vec;                    % T = D for level flight [N]
%   Throttle = (T × V) / P_A   (required propulsive power / available power)
thr_cr_pct = 100 * (T_cr_vec * V_cruise) / P_A_cr;   % [%]

% --- 8c: Descent throttle ------------------------------------------------
n_dc = 300;
h_dc_vec  = linspace(h_cruise, 0, n_dc);              % altitude during descent [m]
t_dc_rel  = linspace(0, t_desc_min, n_dc);             % time relative to descent start [min]
W_dc_N    = linspace(W5_kg, W6_kg, n_dc) * g;         % weight W5→W6 [N]
thr_dc_pct = zeros(1, n_dc);

for i = 1:n_dc
    [~, rho_d, ~, ~] = StdAtmos(h_dc_vec(i));
    sigma_d = rho_d / rho_SL;
    P_A_d   = sigma_d * P_A_SL;                        % [W]
    q_d     = 0.5 * rho_d * V_descent^2;               % [N/m²]
    CL_d    = W_dc_N(i) / (q_d * S);                  % [-]
    CD_d    = CD0 + k * CL_d^2;                        % [-]
    D_d     = q_d * S * CD_d;                          % [N]

    %   Along-path force balance (constant speed, constant angle):
    %     T + W·sin(γ) = D   →   T = D − W·sin(γ)
    %   γ > 0 → gravity component assists forward motion.
    %   T > 0: need thrust (drag exceeds gravity component → apply throttle)
    %   T ≤ 0: pure glide (gravity exceeds drag → throttle = 0)
    T_d = D_d - W_dc_N(i) * sin(gamma_desc);

    if T_d > 0
        thr_dc_pct(i) = 100 * (T_d * V_descent) / P_A_d;  % [%]
    else
        thr_dc_pct(i) = 0;
    end
end


